# Copy to scripts/immich-app.env and adjust as needed.
# scripts/immich-app.env is gitignored.

# Where backups are stored (absolute or relative to repo root)
BACKUP_DIR=../immich-backups

# Run backup --if-due only when last backup is at least this many days old
BACKUP_INTERVAL_DAYS=7

# Keep the newest N backup folders (older ones are deleted after a successful backup)
BACKUP_KEEP=4

# Compose file relative to the docker/ directory
COMPOSE_FILE=docker-compose.dev.yml

# Immich env file (UPLOAD_LOCATION, DB_*, etc.)
ENV_FILE=docker/.env

# On update: also pull Immich upstream into the current branch (merge)
UPDATE_SYNC_ON_UPDATE=true
